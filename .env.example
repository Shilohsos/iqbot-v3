BOT_TOKEN=<your Telegram bot token>
BOT_USERNAME=Shiloh10xbot
IQ_SSID=<your IQ Option session ID>
PLATFORM_ID=15
IQ_WS_URL=wss://ws.iqoption.com/echo/websocket
IQ_HOST=https://ws.iqoption.com

# ─── Yacht Club Setup Engine ────────────────────────────────────────────────
# The VIP channel the engine posts setups and results to.
YACHT_CHANNEL_ID=-1004351740042
# The DEDICATED IQ Option account the engine trades. Not a member account, and
# not the admin account — the engine keeps its own SDK and never uses sdkPool.
# 2FA must be OFF on this account: an unattended engine cannot answer a code.
YACHT_IQ_EMAIL=__PLACEHOLDER__
YACHT_IQ_PASSWORD=__PLACEHOLDER__
# MTProto StringSession for the REAL Telegram user account that posts to the
# channel. Must be its own session — sharing one auth key across clients causes
# AUTH_KEY_DUPLICATED (see the ownership rule at the top of src/affiliate.ts).
# Uses the same TELEGRAM_API_ID / TELEGRAM_API_HASH pair as every other consumer.
YACHT_TELEGRAM_SESSION=__PLACEHOLDER__
